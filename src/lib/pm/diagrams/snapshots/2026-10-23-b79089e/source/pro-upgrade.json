  "cards": [
    {
      "dot": "violet",
      "title": "Who the customer is",
      "items": [
        "The Polar customer's external id is the Airsc user id, set at checkout",
        "Pro means Polar currently grants the POLAR_BENEFIT_PRO benefit",
        "Pro is one payment, kept for life; there are no renewals",
        "Price and launch seats come from Polar (proOffer, cached 1 minute), so /pricing never promises a price checkout will not honour"
      ]
    },
    {
      "dot": "rose",
      "title": "Webhook safety",
      "items": [
        "Bad signature: 403; unknown event type: 202 so Polar stops retrying",
        "set_pro and record_order need AIRSC_INGEST_TOKEN and only the anon role may call them",
        "record_order is idempotent on the Polar order id"
      ]
    },
    {
      "dot": "amber",
      "title": "Other paths",
      "items": [
        "Checkout that fails to start returns with ?billing=error",
        "Manage billing opens Polar's customer portal (card, invoices)",
        "/admin can sync every Polar order and give or take Pro by hand"
      ]
    }
  ]
