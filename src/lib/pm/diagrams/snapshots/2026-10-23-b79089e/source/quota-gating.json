  "cards": [
    {
      "dot": "cyan",
      "title": "Limits",
      "items": [
        "Free account: 5 install unlocks and 30 MCP calls a day",
        "MCP with no key: 10 calls and 2 installs a day, counted per salted IP hash",
        "Pro (profiles.fulltime): no limit; calls are still counted",
        "Days are Vietnam days; the same resource twice in a day costs one unlock"
      ]
    },
    {
      "dot": "violet",
      "title": "Two ways in, one RPC",
      "items": [
        "Website: the page peeks with consume false; only the Unlock button spends one",
        "MCP: every tool call spends one; install_resource also spends an install",
        "An airsc_ key is mapped to its user, so key and web share one Free allowance"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure behaviour",
      "items": [
        "If the quota_use RPC errors, quota() returns allowed (fails open)",
        "quota_use runs server-side only: anon key plus AIRSC_INGEST_TOKEN",
        "Opening the GitHub source is never limited"
      ]
    }
  ]
