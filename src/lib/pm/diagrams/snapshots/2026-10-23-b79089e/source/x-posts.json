  "cards": [
    {
      "dot": "emerald",
      "title": "When it runs",
      "items": [
        "Spotlights are drafted at :30 once the engine run is done: one per posting hour set in Settings",
        "Applied posts are written from your notes in /admin/social/new and wait in the queue too",
        "Posts are sent by the five-minute cron within five minutes of their time"
      ]
    },
    {
      "dot": "rose",
      "title": "Never twice, never tagged by accident",
      "items": [
        "The claim moves draft or approved to posting, so only one caller can post it",
        "A failure is stored on the row; nothing retries on its own",
        "The author's @ stays only if you approved the post; X forbids automated mentions"
      ]
    },
    {
      "dot": "amber",
      "title": "Numbers and keys",
      "items": [
        "Views, likes, reposts and clicks are read from X every few hours for eight days",
        "Every three days Sonnet compares the period with the one before and rewrites the writing guidance",
        "X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN, X_ACCESS_TOKEN_SECRET are set for Production only"
      ]
    }
  ]
